      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.registered_agents SET status=$2, last_heartbeat=$3::timestamptz, updated_at=$3::timestamptz, expires_at=CASE WHEN $2='active' THEN GREATEST(expires_at,$3::timestamptz + INTERVAL '30 days') ELSE expires_at END, failure_count=CASE WHEN $2='active' THEN 0 ELSE failure_count+1 END, last_error=$4 WHERE agent_id=$1 RETURNING agent_id, agent_name, agent_type, status, endpoint, last_heartbeat, expires_at, updated_at;",
        "options": {
          "queryReplacement": "={{ [$json.agent_id,$json.status,$json.now,$json.last_error] }}"
        }
      },
      "id": "update-agent-heartbeat",
      "name": "Update Agent Heartbeat",
      "type": "n8n-nodes-base.postgres",
