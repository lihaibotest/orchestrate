    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst agentId = String(body.agent_id ?? '').trim();\nif (!agentId) throw new Error('agent_id is required');\nreturn [{json:{agent_id:agentId,status:body.status === 'disabled' ? 'disabled' : 'active',last_error:body.last_error ? String(body.last_error) : null,now:new Date().toISOString()}}];"
      },
      "id": "normalize-heartbeat",
