{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orchestrator:evaluator-planning-agent:v1",
  "title": "EvaluatorPlanningAgentV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "caller_identity", "correlation_id", "session_id", "plan_version", "workflow_version", "evaluation_id", "idempotency_key", "evaluation"],
  "properties": {
    "schema_version": {"const": "evaluator-planning-agent.v1"},
    "contract_version": {"const": "evaluator-planning-agent.v1"},
    "caller_identity": {"const": "evaluator"},
    "correlation_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "plan_version": {"type": "integer", "minimum": 1},
    "workflow_version": {"type": "integer", "minimum": 1},
    "evaluation_id": {"$ref": "#/$defs/id"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "metrics", "opinion"],
      "properties": {
        "execution_id": {"$ref": "#/$defs/id"},
        "node_id": {"$ref": "#/$defs/id"},
        "outcome": {"enum": ["passed", "failed", "inconclusive"]},
        "metrics": {"type": "object", "additionalProperties": {"oneOf": [{"type": "integer"}, {"type": "number"}, {"type": "boolean"}, {"type": "string", "maxLength": 1024}]}},
        "opinion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "recommendation"],
          "properties": {
            "verdict": {"type": "string", "minLength": 1, "maxLength": 128},
            "recommendation": {"type": "string", "minLength": 1, "maxLength": 2048}
          }
        },
        "failure": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["error_class", "error_code", "diagnostic"],
              "properties": {
                "error_class": {"enum": ["technical", "business", "quality", "validation", "unknown"]},
                "error_code": {"type": "string", "minLength": 1, "maxLength": 128},
                "diagnostic": {"type": "string", "maxLength": 8192}
              }
            },
            {"type": "null"}
          ]
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
