{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orchestrator:workflow-repair-decision:v1",
  "title": "WorkflowRepairDecisionV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "correlation_id", "session_id", "workflow_version", "node_id", "classification", "action", "reason_code", "repair_attempt", "max_repair_attempts", "evidence_refs"],
  "properties": {
    "schema_version": {"const": "workflow-repair-decision.v1"},
    "correlation_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "workflow_version": {"type": "integer", "minimum": 1},
    "node_id": {"$ref": "#/$defs/id"},
    "classification": {"enum": ["workflow_local", "external_boundary", "uncertain"]},
    "action": {"enum": ["retry_same_version", "repair_new_version", "escalate", "stop"]},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 128},
    "repair_attempt": {"type": "integer", "minimum": 0, "maximum": 100},
    "max_repair_attempts": {"type": "integer", "minimum": 1, "maximum": 100},
    "evidence_refs": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 2048}}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128}}
}
