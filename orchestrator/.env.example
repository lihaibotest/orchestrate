REGISTRY_NETWORK_NAME=orchestrator_shared
GATEWAY_API_KEY_FILE=./.runtime-secrets/gateway-api-key
GATEWAY_PORT=27880
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY_FILE=./.runtime-secrets/n8n-api-key
N8N_WEBHOOK_CREDENTIAL_REF=orchestrator-webhook
N8N_WEBHOOK_PATH_SECRET_FILE=./.runtime-secrets/n8n-webhook-path
N8N_WEBHOOK_AUTH_VALUE_FILE=./.runtime-secrets/n8n-webhook-auth
ORCHESTRATOR_MONITORING_ENDPOINT=http://172.26.0.1:8080
ORCHESTRATOR_TASK_ORCHESTRATION_ENDPOINT=http://172.26.0.1:7000
ORCHESTRATOR_PLANNING_AGENT_BASE_URL=http://planning-agent:18000
N8N_GATEWAY_BASE_URL=http://orchestrator-gateway:8080
ORCHESTRATOR_WORKFLOW_LLM_BASE_URL=https://api.deepseek.com
ORCHESTRATOR_WORKFLOW_LLM_API_KEY_FILE=./.runtime-secrets/deepseek-api-key
ORCHESTRATOR_WORKFLOW_LLM_MODEL=deepseek-v4-flash
ORCHESTRATOR_PORT=18020
ORCHESTRATOR_PLANNING_AGENT_HMAC_SECRET_FILE=./.runtime-secrets/planning-hmac
ORCHESTRATOR_N8N_HMAC_SECRET_FILE=./.runtime-secrets/n8n-hmac
ORCHESTRATOR_POSTGRES_DSN=postgresql://orchestrator@postgres:5432/orchestrator
ORCHESTRATOR_POSTGRES_SCHEMA=orchestrator
ORCHESTRATOR_REDIS_URL=redis://redis:6379/0
ORCHESTRATOR_REDIS_REQUIRED=false
# External MinIO endpoint. The SDK also accepts 192.168.137.98:9001;
# keep the scheme here so the configured URL is explicit.
ORCHESTRATOR_MINIO_ENDPOINT=http://192.168.137.98:9001
ORCHESTRATOR_MINIO_BUCKET=orchestrator-artifacts
ORCHESTRATOR_MINIO_ACCESS_KEY_FILE=./.runtime-secrets/minio-access-key
ORCHESTRATOR_MINIO_SECRET_KEY_FILE=./.runtime-secrets/minio-secret-key
ORCHESTRATOR_MINIO_SECURE=false
ORCHESTRATOR_V2_ENABLED=true
ORCHESTRATOR_V2_AGENT_ALLOWED_HOSTS=collector.internal,reporter.internal,evaluator.internal
ORCHESTRATOR_V2_ALLOWED_PRIVATE_CIDRS=
N8N_GATEWAY_CREDENTIAL_REF=orchestrator-gateway
